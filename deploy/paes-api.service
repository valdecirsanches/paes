[Unit]
Description=Paes - API (Node/Express)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sanches
WorkingDirectory=/home/sanches/apps/paes/server
Environment=NODE_ENV=production
Environment=PORT=5071
# Lê também server/.env (DB_*, NFE_*); as variáveis acima têm prioridade.
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
