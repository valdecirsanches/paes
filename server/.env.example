PORT=5071
DB_HOST=192.168.15.10
DB_PORT=3306
DB_USER=sadmin
DB_PASSWORD=
DB_NAME=levpao_new
# Se acentos aparecerem errados, tente latin1
DB_CHARSET=utf8mb4
# Origens permitidas (separe por vírgula). Vazio = qualquer origem.
CORS_ORIGIN=

# --- API de NF-e (substitui o ACBrMonitor/EDSMonitorPlus) ---
NFE_API_URL=http://127.0.0.1:5240
# Mesmo valor do NFE_API_TOKEN configurado na API (cabeçalho Authorization: Bearer ...)
NFE_API_TOKEN=
# Opcional: id (GUID) da empresa na API. Vazio = descobre pelo CNPJ de tb_nfe_config
NFE_EMPRESA_ID=
# Opcional: pasta dos XML/PDF autorizados (padrão: server/xmls)
NFE_XML_DIR=
# Como as OUTRAS máquinas (sistema antigo) enxergam a pasta acima; vai nos campos nfe_xml_file/nfe_pdf_file. Ex.: \\\\192.168.15.8\\nfe  ou  Z:\\nfe  (vazio = grava o caminho Linux)
NFE_XML_DB_PREFIXO=
# Pasta onde a API de NF-e guarda os arquivos: <pasta>/<cnpj>/NFe/<data da autorização>/<NFe ou Evento>/
NFE_ARQUIVOS_DIR=/mnt/hdbackup/API/levpao/arquivos/nfe/EDSMonitorPLUS/Arqs
# Opcional: indicador de presença (padrão 1) e tempo limite em ms (padrão 90000)
NFE_IND_PRES=1
NFE_API_TIMEOUT_MS=90000

# Autenticação da API de NF-e (padrão: Authorization: Bearer <token>).
# Se o seu outro app usa outro cabeçalho, ajuste (ex.: NFE_API_AUTH_HEADER=X-Api-Key e NFE_API_AUTH_SCHEME= vazio).
# NFE_API_AUTH_HEADER=Authorization
# NFE_API_AUTH_SCHEME=Bearer

# Arquivo local com o id do certificado A3 (padrão: server/nfe-a3.json)
# NFE_A3_FILE=

# Segredo para assinar a sessão de login (use uma frase longa e aleatória). Vazio = muda a cada reinício.
SESSION_SECRET=

# Impressão: o agente roda no Windows e o servidor está em outra máquina (Linux).
# No agente (config.json): "escuta": "0.0.0.0" e "token": "<mínimo 16 caracteres>". Aqui, o mesmo token:
# AGENTE_URL=http://192.168.15.8:9101
# AGENTE_TOKEN=

# Controle de dispositivos (tela Ferramentas > Dispositivos). 1 = desliga o controle (emergência: libera todos)
DISPOSITIVOS_LIVRE=
